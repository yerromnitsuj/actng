{
  "name": "@actuarial-ts/core",
  "version": "0.7.0",
  "description": "Pure, zero-dependency P&C actuarial math for TypeScript: reserving, generalized definition-driven diagnostics, trends, limits, discounting, and seeded stochastic methods with published-value validation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerromnitsuj/actng.git",
    "directory": "packages/core"
  },
  "keywords": [
    "actuarial",
    "reserving",
    "chain-ladder",
    "mack",
    "bornhuetter-ferguson",
    "cape-cod",
    "berquist-sherman",
    "loss-development",
    "triangle",
    "ibnr",
    "insurance",
    "property-casualty",
    "odp-bootstrap",
    "merz-wuthrich",
    "munich-chain-ladder",
    "clark",
    "stochastic-reserving",
    "ulae",
    "discounting"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../tools/release/verify-release-attestation.mjs @actuarial-ts/core"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
